{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "!.well-known/**",
      "**/node_modules/**",
      "app/**",
      "build/**",
      "gradle/**",
      "android.keystore",
      "gradlew",
      "gradlew.bat",
      "build.gradle",
      "settings.gradle",
      "gradle.properties",
      "local.properties",
      "manifest-checksum.txt",
      "twa-manifest.json"
    ],
    "headers": [
      {
        "source": "/service-worker.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ]
  }
}